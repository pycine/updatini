{
  "name": "updatini",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source OTA update console for embedded systems — RAUC bundles on Cloudflare Workers, R2 and D1.",
  "keywords": [
    "ota",
    "firmware",
    "rauc",
    "embedded",
    "cloudflare-workers",
    "r2",
    "d1",
    "iot"
  ],
  "homepage": "https://github.com/pycine/updatini#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pycine/updatini.git"
  },
  "bugs": {
    "url": "https://github.com/pycine/updatini/issues"
  },
  "license": "MIT",
  "author": "Muhammad Yacin (https://github.com/pycine)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "token": "node scripts/generate-admin-token.mjs",
    "token:local": "node scripts/generate-admin-token.mjs --local",
    "db:init": "wrangler d1 execute updatini --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute updatini --file=./schema.sql --local",
    "check": "node --check src/worker.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
